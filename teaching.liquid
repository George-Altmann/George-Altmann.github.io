<div class="teaching">
  {% if site.teaching != blank %}
    {% assign teaching = site.teaching | sort: "order" %}
    {% assign teaching_limit = 100 %} 
    {% for item in teaching limit: teaching_limit %}
      <p>
        <strong>{{ item.year }}</strong>:
        <a class="teaching-title" href="{{ item.url | relative_url }}">
          {{ item.title }}
        </a>,
        {{ item.institution }}
      </p>
    {% endfor %}
  {% else %}
    <p>No teaching items so far...</p>
  {% endif %}
</div>

